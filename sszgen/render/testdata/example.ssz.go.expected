package foo

import (
	binary "encoding/binary"
	"fmt"
	go_bitfield "github.com/OffchainLabs/go-bitfield"
	ssz "github.com/OffchainLabs/methodical-ssz/ssz"
	uint256 "github.com/holiman/uint256"
)

func (c *Example) SizeSSZ() int {
	size := 781
	size += len(c.C) * 8
	for _, o := range c.D {
		size += 4
		size += len(o)
	}
	for _, o := range c.E {
		size += 4
		size += o.SizeSSZ()
	}
	if c.F == nil {
		c.F = new(Inner)
	}
	size += c.F.SizeSSZ()
	size += len(c.K)
	size += len(c.L)
	size += len(c.N) * 8
	for _, o := range c.P {
		size += 4
		size += len(o)
	}
	for _, o := range c.Q {
		size += 4
		size += o.SizeSSZ()
	}
	for _, o := range c.U {
		size += 4
		size += len(o) * 8
	}
	for _, o := range c.V {
		size += 4
		size += len(o) * 8
	}
	size += len(c.Z) * 2
	size += len(c.AB) * 32
	size += len(c.AF)
	for _, o := range c.AG {
		size += 4
		size += len(o)
	}
	for _, o := range c.AH {
		size += 4
		size += len(o)
	}
	size += len(c.AJ) * 32
	size += len(c.AL) * 48
	size += len(c.AO) * 32
	return size
}

func (c *Example) MarshalSSZ() ([]byte, error) {
	buf := make([]byte, c.SizeSSZ())
	return c.MarshalSSZTo(buf[:0])
}

func (c *Example) MarshalSSZTo(dst []byte) ([]byte, error) {
	var err error
	offset := 781

	// Field 0: A
	dst = binary.LittleEndian.AppendUint64(dst, c.A)

	// Field 1: B
	if len(c.B) != 32 {
		return nil, ssz.ErrBytesLength
	}
	dst = append(dst, c.B...)

	// Field 2: C
	dst = ssz.WriteOffset(dst, offset)
	offset += len(c.C) * 8

	// Field 3: D
	dst = ssz.WriteOffset(dst, offset)
	for _, o := range c.D {
		offset += 4
		offset += len(o)
	}

	// Field 4: E
	dst = ssz.WriteOffset(dst, offset)
	for _, o := range c.E {
		offset += 4
		offset += o.SizeSSZ()
	}

	// Field 5: F
	if c.F == nil {
		c.F = new(Inner)
	}
	dst = ssz.WriteOffset(dst, offset)
	offset += c.F.SizeSSZ()

	// Field 6: G
	if len(c.G) != 4 {
		return nil, ssz.ErrBytesLength
	}
	for _, o := range c.G {
		if len(o) != 32 {
			return nil, ssz.ErrBytesLength
		}
		dst = append(dst, o...)
	}

	// Field 7: H
	dst = binary.LittleEndian.AppendUint64(dst, uint64(c.H))

	// Field 8: I
	if len(c.I) != 4 {
		return nil, ssz.ErrBytesLength
	}
	for _, o := range c.I {
		dst = binary.LittleEndian.AppendUint64(dst, o)
	}

	// Field 9: J
	if len([]byte(c.J)) != 1 {
		return nil, ssz.ErrBytesLength
	}
	dst = append(dst, []byte(c.J)...)

	// Field 10: K
	dst = ssz.WriteOffset(dst, offset)
	offset += len(c.K)

	// Field 11: L
	dst = ssz.WriteOffset(dst, offset)
	offset += len(c.L)

	// Field 12: M
	if len(c.M) != 4 {
		return nil, ssz.ErrBytesLength
	}
	for _, o := range c.M {
		dst = binary.LittleEndian.AppendUint64(dst, uint64(o))
	}

	// Field 13: N
	dst = ssz.WriteOffset(dst, offset)
	offset += len(c.N) * 8

	// Field 14: O
	if len(c.O) != 4 {
		return nil, ssz.ErrBytesLength
	}
	for _, o := range c.O {
		if dst, err = o.MarshalSSZTo(dst); err != nil {
			return nil, fmt.Errorf("O: %w", err)
		}
	}

	// Field 15: P
	dst = ssz.WriteOffset(dst, offset)
	for _, o := range c.P {
		offset += 4
		offset += len(o)
	}

	// Field 16: Q
	dst = ssz.WriteOffset(dst, offset)
	for _, o := range c.Q {
		offset += 4
		offset += o.SizeSSZ()
	}

	// Field 17: R
	if c.R {
		dst = append(dst, 1)
	} else {
		dst = append(dst, 0)
	}

	// Field 18: S
	dst = binary.LittleEndian.AppendUint16(dst, c.S)

	// Field 19: T
	dst = binary.LittleEndian.AppendUint32(dst, c.T)

	// Field 20: U
	dst = ssz.WriteOffset(dst, offset)
	for _, o := range c.U {
		offset += 4
		offset += len(o) * 8
	}

	// Field 21: V
	dst = ssz.WriteOffset(dst, offset)
	for _, o := range c.V {
		offset += 4
		offset += len(o) * 8
	}

	// Field 22: W
	if len([]byte(c.W)) != 32 {
		return nil, ssz.ErrBytesLength
	}
	dst = append(dst, []byte(c.W)...)

	// Field 23: X
	if len(c.X) != 4 {
		return nil, ssz.ErrBytesLength
	}
	for _, o := range c.X {
		if len([]byte(o)) != 1 {
			return nil, ssz.ErrBytesLength
		}
		dst = append(dst, []byte(o)...)
	}

	// Field 24: Y
	if len(c.Y) != 8 {
		return nil, ssz.ErrBytesLength
	}
	for _, o := range c.Y {
		dst = binary.LittleEndian.AppendUint32(dst, o)
	}

	// Field 25: Z
	dst = ssz.WriteOffset(dst, offset)
	offset += len(c.Z) * 2

	// Field 26: AA
	if len(c.AA) != 2 {
		return nil, ssz.ErrBytesLength
	}
	for _, o := range c.AA {
		if len(o) != 4 {
			return nil, ssz.ErrBytesLength
		}
		for _, oo := range o {
			dst = binary.LittleEndian.AppendUint64(dst, oo)
		}
	}

	// Field 27: AB
	dst = ssz.WriteOffset(dst, offset)
	offset += len(c.AB) * 32

	// Field 28: AC
	if len(c.AC) != 32 {
		return nil, ssz.ErrBytesLength
	}
	dst = append(dst, c.AC[:]...)

	// Field 29: AD
	dst = append(dst, c.AD)

	// Field 30: AE
	if len(c.AE) != 4 {
		return nil, ssz.ErrBytesLength
	}
	for _, o := range c.AE {
		if o {
			dst = append(dst, 1)
		} else {
			dst = append(dst, 0)
		}
	}

	// Field 31: AF
	dst = ssz.WriteOffset(dst, offset)
	offset += len(c.AF)

	// Field 32: AG
	dst = ssz.WriteOffset(dst, offset)
	for _, o := range c.AG {
		offset += 4
		offset += len(o)
	}

	// Field 33: AH
	dst = ssz.WriteOffset(dst, offset)
	for _, o := range c.AH {
		offset += 4
		offset += len(o)
	}

	// Field 34: AI
	dst = binary.LittleEndian.AppendUint64(dst, c.AI[0])
	dst = binary.LittleEndian.AppendUint64(dst, c.AI[1])
	dst = binary.LittleEndian.AppendUint64(dst, c.AI[2])
	dst = binary.LittleEndian.AppendUint64(dst, c.AI[3])

	// Field 35: AJ
	dst = ssz.WriteOffset(dst, offset)
	offset += len(c.AJ) * 32

	// Field 36: AK
	if len(c.AK) != 2 {
		return nil, ssz.ErrBytesLength
	}
	for _, o := range c.AK {
		dst = binary.LittleEndian.AppendUint64(dst, o[0])
		dst = binary.LittleEndian.AppendUint64(dst, o[1])
		dst = binary.LittleEndian.AppendUint64(dst, o[2])
		dst = binary.LittleEndian.AppendUint64(dst, o[3])
	}

	// Field 37: AL
	dst = ssz.WriteOffset(dst, offset)
	offset += len(c.AL) * 48

	// Field 38: AM
	if len(c.AM) != 4 {
		return nil, ssz.ErrBytesLength
	}
	for _, o := range c.AM {
		if len(o) != 32 {
			return nil, ssz.ErrBytesLength
		}
		dst = append(dst, o[:]...)
	}

	// Field 39: AN
	if len(c.AN) != 32 {
		return nil, ssz.ErrBytesLength
	}
	dst = append(dst, c.AN[:]...)

	// Field 40: AO
	dst = ssz.WriteOffset(dst, offset)
	offset += len(c.AO) * 32

	// Field 2: C
	if len(c.C) > 1024 {
		return nil, ssz.ErrListTooBig
	}
	for _, o := range c.C {
		dst = binary.LittleEndian.AppendUint64(dst, o)
	}

	// Field 3: D
	if len(c.D) > 256 {
		return nil, ssz.ErrListTooBig
	}
	{
		offset = 4 * len(c.D)
		for _, o := range c.D {
			dst = ssz.WriteOffset(dst, offset)
			offset += len(o)
		}
	}
	for _, o := range c.D {
		if len(o) > 64 {
			return nil, ssz.ErrListTooBig
		}
		dst = append(dst, o...)
	}

	// Field 4: E
	if len(c.E) > 128 {
		return nil, ssz.ErrListTooBig
	}
	{
		offset = 4 * len(c.E)
		for _, o := range c.E {
			dst = ssz.WriteOffset(dst, offset)
			offset += o.SizeSSZ()
		}
	}
	for _, o := range c.E {
		if dst, err = o.MarshalSSZTo(dst); err != nil {
			return nil, fmt.Errorf("E: %w", err)
		}
	}

	// Field 5: F
	if dst, err = c.F.MarshalSSZTo(dst); err != nil {
		return nil, fmt.Errorf("F: %w", err)
	}

	// Field 10: K
	if len(c.K) > 256 {
		return nil, ssz.ErrListTooBig
	}
	dst = append(dst, c.K...)

	// Field 11: L
	if len(c.L) > 2048 {
		return nil, ssz.ErrListTooBig
	}
	dst = append(dst, c.L...)

	// Field 13: N
	if len(c.N) > 1024 {
		return nil, ssz.ErrListTooBig
	}
	for _, o := range c.N {
		dst = binary.LittleEndian.AppendUint64(dst, uint64(o))
	}

	// Field 15: P
	if len(c.P) != 4 {
		return nil, ssz.ErrBytesLength
	}
	{
		offset = 4 * len(c.P)
		for _, o := range c.P {
			dst = ssz.WriteOffset(dst, offset)
			offset += len(o)
		}
	}
	for _, o := range c.P {
		if len(o) > 64 {
			return nil, ssz.ErrListTooBig
		}
		dst = append(dst, o...)
	}

	// Field 16: Q
	if len(c.Q) != 4 {
		return nil, ssz.ErrBytesLength
	}
	{
		offset = 4 * len(c.Q)
		for _, o := range c.Q {
			dst = ssz.WriteOffset(dst, offset)
			offset += o.SizeSSZ()
		}
	}
	for _, o := range c.Q {
		if dst, err = o.MarshalSSZTo(dst); err != nil {
			return nil, fmt.Errorf("Q: %w", err)
		}
	}

	// Field 20: U
	if len(c.U) > 32 {
		return nil, ssz.ErrListTooBig
	}
	{
		offset = 4 * len(c.U)
		for _, o := range c.U {
			dst = ssz.WriteOffset(dst, offset)
			offset += len(o) * 8
		}
	}
	for _, o := range c.U {
		if len(o) > 16 {
			return nil, ssz.ErrListTooBig
		}
		for _, oo := range o {
			dst = binary.LittleEndian.AppendUint64(dst, oo)
		}
	}

	// Field 21: V
	if len(c.V) != 4 {
		return nil, ssz.ErrBytesLength
	}
	{
		offset = 4 * len(c.V)
		for _, o := range c.V {
			dst = ssz.WriteOffset(dst, offset)
			offset += len(o) * 8
		}
	}
	for _, o := range c.V {
		if len(o) > 16 {
			return nil, ssz.ErrListTooBig
		}
		for _, oo := range o {
			dst = binary.LittleEndian.AppendUint64(dst, oo)
		}
	}

	// Field 25: Z
	if len(c.Z) > 100 {
		return nil, ssz.ErrListTooBig
	}
	for _, o := range c.Z {
		dst = binary.LittleEndian.AppendUint16(dst, o)
	}

	// Field 27: AB
	if len(c.AB) > 32 {
		return nil, ssz.ErrListTooBig
	}
	for _, o := range c.AB {
		if len(o) != 4 {
			return nil, ssz.ErrBytesLength
		}
		for _, oo := range o {
			dst = binary.LittleEndian.AppendUint64(dst, oo)
		}
	}

	// Field 31: AF
	if len(c.AF) > 100 {
		return nil, ssz.ErrListTooBig
	}
	for _, o := range c.AF {
		if o {
			dst = append(dst, 1)
		} else {
			dst = append(dst, 0)
		}
	}

	// Field 32: AG
	if len(c.AG) > 4 {
		return nil, ssz.ErrListTooBig
	}
	{
		offset = 4 * len(c.AG)
		for _, o := range c.AG {
			dst = ssz.WriteOffset(dst, offset)
			offset += len(o)
		}
	}
	for _, o := range c.AG {
		if len(o) > 2048 {
			return nil, ssz.ErrListTooBig
		}
		dst = append(dst, o...)
	}

	// Field 33: AH
	if len(c.AH) != 2 {
		return nil, ssz.ErrBytesLength
	}
	{
		offset = 4 * len(c.AH)
		for _, o := range c.AH {
			dst = ssz.WriteOffset(dst, offset)
			offset += len(o)
		}
	}
	for _, o := range c.AH {
		if len(o) > 2048 {
			return nil, ssz.ErrListTooBig
		}
		dst = append(dst, o...)
	}

	// Field 35: AJ
	if len(c.AJ) > 8 {
		return nil, ssz.ErrListTooBig
	}
	for _, o := range c.AJ {
		dst = binary.LittleEndian.AppendUint64(dst, o[0])
		dst = binary.LittleEndian.AppendUint64(dst, o[1])
		dst = binary.LittleEndian.AppendUint64(dst, o[2])
		dst = binary.LittleEndian.AppendUint64(dst, o[3])
	}

	// Field 37: AL
	if len(c.AL) > 16 {
		return nil, ssz.ErrListTooBig
	}
	for _, o := range c.AL {
		if len(o) != 48 {
			return nil, ssz.ErrBytesLength
		}
		dst = append(dst, o[:]...)
	}

	// Field 40: AO
	if len(c.AO) > 8 {
		return nil, ssz.ErrListTooBig
	}
	for _, o := range c.AO {
		if len(o) != 32 {
			return nil, ssz.ErrBytesLength
		}
		dst = append(dst, o[:]...)
	}
	return dst, err
}

func (c *Example) UnmarshalSSZ(buf []byte) error {
	var err error
	size := uint64(len(buf))
	if size < 781 {
		return ssz.ErrSize
	}

	sszSlice0 := buf[0:8]      // c.A
	sszSlice1 := buf[8:40]     // c.B
	sszSlice6 := buf[56:184]   // c.G
	sszSlice7 := buf[184:192]  // c.H
	sszSlice8 := buf[192:224]  // c.I
	sszSlice9 := buf[224:225]  // c.J
	sszSlice12 := buf[233:265] // c.M
	sszSlice14 := buf[269:301] // c.O
	sszSlice17 := buf[309:310] // c.R
	sszSlice18 := buf[310:312] // c.S
	sszSlice19 := buf[312:316] // c.T
	sszSlice22 := buf[324:356] // c.W
	sszSlice23 := buf[356:360] // c.X
	sszSlice24 := buf[360:392] // c.Y
	sszSlice26 := buf[396:460] // c.AA
	sszSlice28 := buf[464:496] // c.AC
	sszSlice29 := buf[496:497] // c.AD
	sszSlice30 := buf[497:501] // c.AE
	sszSlice34 := buf[513:545] // c.AI
	sszSlice36 := buf[549:613] // c.AK
	sszSlice38 := buf[617:745] // c.AM
	sszSlice39 := buf[745:777] // c.AN

	sszVarOffset2 := ssz.ReadOffset(buf[40:44]) // c.C
	if sszVarOffset2 != 781 {
		return ssz.ErrInvalidVariableOffset
	}
	if sszVarOffset2 > size {
		return ssz.ErrOffset
	}
	sszVarOffset3 := ssz.ReadOffset(buf[44:48]) // c.D
	if sszVarOffset3 > size || sszVarOffset3 < sszVarOffset2 {
		return ssz.ErrOffset
	}
	sszVarOffset4 := ssz.ReadOffset(buf[48:52]) // c.E
	if sszVarOffset4 > size || sszVarOffset4 < sszVarOffset3 {
		return ssz.ErrOffset
	}
	sszVarOffset5 := ssz.ReadOffset(buf[52:56]) // c.F
	if sszVarOffset5 > size || sszVarOffset5 < sszVarOffset4 {
		return ssz.ErrOffset
	}
	sszVarOffset10 := ssz.ReadOffset(buf[225:229]) // c.K
	if sszVarOffset10 > size || sszVarOffset10 < sszVarOffset5 {
		return ssz.ErrOffset
	}
	sszVarOffset11 := ssz.ReadOffset(buf[229:233]) // c.L
	if sszVarOffset11 > size || sszVarOffset11 < sszVarOffset10 {
		return ssz.ErrOffset
	}
	sszVarOffset13 := ssz.ReadOffset(buf[265:269]) // c.N
	if sszVarOffset13 > size || sszVarOffset13 < sszVarOffset11 {
		return ssz.ErrOffset
	}
	sszVarOffset15 := ssz.ReadOffset(buf[301:305]) // c.P
	if sszVarOffset15 > size || sszVarOffset15 < sszVarOffset13 {
		return ssz.ErrOffset
	}
	sszVarOffset16 := ssz.ReadOffset(buf[305:309]) // c.Q
	if sszVarOffset16 > size || sszVarOffset16 < sszVarOffset15 {
		return ssz.ErrOffset
	}
	sszVarOffset20 := ssz.ReadOffset(buf[316:320]) // c.U
	if sszVarOffset20 > size || sszVarOffset20 < sszVarOffset16 {
		return ssz.ErrOffset
	}
	sszVarOffset21 := ssz.ReadOffset(buf[320:324]) // c.V
	if sszVarOffset21 > size || sszVarOffset21 < sszVarOffset20 {
		return ssz.ErrOffset
	}
	sszVarOffset25 := ssz.ReadOffset(buf[392:396]) // c.Z
	if sszVarOffset25 > size || sszVarOffset25 < sszVarOffset21 {
		return ssz.ErrOffset
	}
	sszVarOffset27 := ssz.ReadOffset(buf[460:464]) // c.AB
	if sszVarOffset27 > size || sszVarOffset27 < sszVarOffset25 {
		return ssz.ErrOffset
	}
	sszVarOffset31 := ssz.ReadOffset(buf[501:505]) // c.AF
	if sszVarOffset31 > size || sszVarOffset31 < sszVarOffset27 {
		return ssz.ErrOffset
	}
	sszVarOffset32 := ssz.ReadOffset(buf[505:509]) // c.AG
	if sszVarOffset32 > size || sszVarOffset32 < sszVarOffset31 {
		return ssz.ErrOffset
	}
	sszVarOffset33 := ssz.ReadOffset(buf[509:513]) // c.AH
	if sszVarOffset33 > size || sszVarOffset33 < sszVarOffset32 {
		return ssz.ErrOffset
	}
	sszVarOffset35 := ssz.ReadOffset(buf[545:549]) // c.AJ
	if sszVarOffset35 > size || sszVarOffset35 < sszVarOffset33 {
		return ssz.ErrOffset
	}
	sszVarOffset37 := ssz.ReadOffset(buf[613:617]) // c.AL
	if sszVarOffset37 > size || sszVarOffset37 < sszVarOffset35 {
		return ssz.ErrOffset
	}
	sszVarOffset40 := ssz.ReadOffset(buf[777:781]) // c.AO
	if sszVarOffset40 > size || sszVarOffset40 < sszVarOffset37 {
		return ssz.ErrOffset
	}
	sszSlice2 := buf[sszVarOffset2:sszVarOffset3]    // c.C
	sszSlice3 := buf[sszVarOffset3:sszVarOffset4]    // c.D
	sszSlice4 := buf[sszVarOffset4:sszVarOffset5]    // c.E
	sszSlice5 := buf[sszVarOffset5:sszVarOffset10]   // c.F
	sszSlice10 := buf[sszVarOffset10:sszVarOffset11] // c.K
	sszSlice11 := buf[sszVarOffset11:sszVarOffset13] // c.L
	sszSlice13 := buf[sszVarOffset13:sszVarOffset15] // c.N
	sszSlice15 := buf[sszVarOffset15:sszVarOffset16] // c.P
	sszSlice16 := buf[sszVarOffset16:sszVarOffset20] // c.Q
	sszSlice20 := buf[sszVarOffset20:sszVarOffset21] // c.U
	sszSlice21 := buf[sszVarOffset21:sszVarOffset25] // c.V
	sszSlice25 := buf[sszVarOffset25:sszVarOffset27] // c.Z
	sszSlice27 := buf[sszVarOffset27:sszVarOffset31] // c.AB
	sszSlice31 := buf[sszVarOffset31:sszVarOffset32] // c.AF
	sszSlice32 := buf[sszVarOffset32:sszVarOffset33] // c.AG
	sszSlice33 := buf[sszVarOffset33:sszVarOffset35] // c.AH
	sszSlice35 := buf[sszVarOffset35:sszVarOffset37] // c.AJ
	sszSlice37 := buf[sszVarOffset37:sszVarOffset40] // c.AL
	sszSlice40 := buf[sszVarOffset40:]               // c.AO

	// Field 0: A
	c.A = binary.LittleEndian.Uint64(sszSlice0)

	// Field 1: B
	c.B = make([]byte, 0, 32)
	c.B = append(c.B, sszSlice1...)

	// Field 2: C
	{
		if len(sszSlice2)%8 != 0 {
			return fmt.Errorf("misaligned bytes: c.C length is %d, which is not a multiple of 8: %w", len(sszSlice2), ssz.ErrIncorrectListSize)
		}
		numElem := len(sszSlice2) / 8
		if numElem > 1024 {
			return fmt.Errorf("ssz-max exceeded: c.C has %d elements, ssz-max is 1024: %w", numElem, ssz.ErrListTooBig)
		}
		c.C = make([]uint64, numElem)
		for i := 0; i < numElem; i++ {
			var tmp uint64

			tmpSlice := sszSlice2[i*8 : (1+i)*8]
			tmp = binary.LittleEndian.Uint64(tmpSlice)
			c.C[i] = tmp
		}
	}

	// Field 3: D
	{
		// empty lists are zero length, so make sure there is room for an offset
		// before attempting to unmarshal it
		if len(sszSlice3) > 3 {
			startOffset := ssz.ReadOffset(sszSlice3[0:4])
			if startOffset == 0 {
				return fmt.Errorf("encountered invalid offset of 0 when decoding c.D")
			}
			if startOffset%4 != 0 {
				return fmt.Errorf("misaligned list bytes: when decoding c.D, end-of-list offset is %d, which is not a multiple of 4 (offset size)", startOffset)
			}
			listLen := startOffset / 4
			if listLen > 256 {
				return fmt.Errorf("ssz-max exceeded: c.D has %d elements, ssz-max is 256: %w", listLen, ssz.ErrListTooBig)
			}
			totalVarBytes := uint64(len(sszSlice3))
