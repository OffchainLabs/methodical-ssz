		}
		numElem := len(sszSlice37) / 48
		if numElem > 16 {
			return fmt.Errorf("ssz-max exceeded: c.AL has %d elements, ssz-max is 16: %w", numElem, ssz.ErrListTooBig)
		}
		c.AL = make([][48]byte, numElem)
		for i := 0; i < numElem; i++ {
			var tmp [48]byte

			tmpSlice := sszSlice37[i*48 : (1+i)*48]
			copy(tmp[:], tmpSlice)
			c.AL[i] = tmp
		}
	}

	// Field 38: AM
	{
		c.AM = make([][32]byte, 4)
		for i := 0; i < 4; i++ {
			var tmp [32]byte

			tmpSlice := sszSlice38[i*32 : (1+i)*32]
			copy(tmp[:], tmpSlice)
			c.AM[i] = tmp
		}
	}

	// Field 39: AN
	copy(c.AN[:], sszSlice39)

	// Field 40: AO
	{
		if len(sszSlice40)%32 != 0 {
			return fmt.Errorf("misaligned bytes: c.AO length is %d, which is not a multiple of 32: %w", len(sszSlice40), ssz.ErrIncorrectListSize)
		}
		numElem := len(sszSlice40) / 32
		if numElem > 8 {
			return fmt.Errorf("ssz-max exceeded: c.AO has %d elements, ssz-max is 8: %w", numElem, ssz.ErrListTooBig)
		}
		c.AO = make([]ArrayRoot, numElem)
		for i := 0; i < numElem; i++ {
			var tmp ArrayRoot

			tmpSlice := sszSlice40[i*32 : (1+i)*32]
			copy(tmp[:], tmpSlice)
			c.AO[i] = tmp
		}
	}
	return err
}

func (c *Example) HashTreeRoot() ([32]byte, error) {
	hh := ssz.DefaultHasherPool.Get()
	if err := c.HashTreeRootWith(hh); err != nil {
		ssz.DefaultHasherPool.Put(hh)
		return [32]byte{}, err
	}
	root, err := hh.HashRoot()
	ssz.DefaultHasherPool.Put(hh)
	return root, err
}

func (c *Example) HashTreeRootWith(hh *ssz.Hasher) (err error) {
	indx := hh.Index()
	// Field 0: A
	hh.PutUint64(c.A)
	// Field 1: B
	if len(c.B) != 32 {
		return ssz.ErrBytesLength
	}
	hh.PutBytes(c.B)
	// Field 2: C
	{
		if len(c.C) > 1024 {
			return ssz.ErrListTooBig
		}
		subIndx := hh.Index()
		for _, o := range c.C {
			hh.AppendUint64(o)
		}
		hh.FillUpTo32()
		numItems := uint64(len(c.C))
		hh.MerkleizeWithMixin(subIndx, numItems, ssz.CalculateLimit(1024, numItems, 8))
	}
	// Field 3: D
	{
		if len(c.D) > 256 {
			return ssz.ErrListTooBig
		}
		subIndx := hh.Index()
		for _, o := range c.D {

			{
				if len(o) > 64 {
					return ssz.ErrBytesLength
				}
				subIndx := hh.Index()
				hh.AppendBytes32(o)
				numItems := uint64(len(o))
				hh.MerkleizeWithMixin(subIndx, numItems, (64*1+31)/32)
			}

		}
		hh.MerkleizeWithMixin(subIndx, uint64(len(c.D)), 256)
	}
	// Field 4: E
	{
		if len(c.E) > 128 {
			return ssz.ErrListTooBig
		}
		subIndx := hh.Index()
		for _, o := range c.E {
			if err := o.HashTreeRootWith(hh); err != nil {
				return fmt.Errorf("E: %w", err)
			}
		}
		hh.MerkleizeWithMixin(subIndx, uint64(len(c.E)), 128)
	}
	// Field 5: F
	if err := c.F.HashTreeRootWith(hh); err != nil {
		return fmt.Errorf("F: %w", err)
	}
	// Field 6: G
	{
		if len(c.G) != 4 {
			return ssz.ErrVectorLength
		}
		subIndx := hh.Index()
		for _, o := range c.G {
			if len(o) != 32 {
				return ssz.ErrBytesLength
			}
			hh.Append(o)
		}
		hh.Merkleize(subIndx)
	}
	// Field 7: H
	hh.PutUint64(uint64(c.H))
	// Field 8: I
	{
		if len(c.I) != 4 {
			return ssz.ErrVectorLength
		}
		subIndx := hh.Index()
		for _, o := range c.I {
			hh.AppendUint64(o)
		}
		hh.Merkleize(subIndx)
	}
	// Field 9: J
	if len([]byte(c.J)) != 1 {
		return ssz.ErrBytesLength
	}
	hh.PutBytes([]byte(c.J))
	// Field 10: K

	{
		if len(c.K) > 256 {
			return ssz.ErrBytesLength
		}
		subIndx := hh.Index()
		hh.AppendBytes32(c.K)
		numItems := uint64(len(c.K))
		hh.MerkleizeWithMixin(subIndx, numItems, (256*1+31)/32)
	}

	// Field 11: L
	if len(c.L) == 0 {
		return ssz.ErrEmptyBitlist
	}
	hh.PutBitlist(c.L, 2048)
	// Field 12: M
	{
		if len(c.M) != 4 {
			return ssz.ErrVectorLength
		}
		subIndx := hh.Index()
		for _, o := range c.M {
			hh.AppendUint64(uint64(o))
		}
		hh.Merkleize(subIndx)
	}
	// Field 13: N
	{
		if len(c.N) > 1024 {
			return ssz.ErrListTooBig
		}
		subIndx := hh.Index()
		for _, o := range c.N {
			hh.AppendUint64(uint64(o))
		}
		hh.FillUpTo32()
		numItems := uint64(len(c.N))
		hh.MerkleizeWithMixin(subIndx, numItems, ssz.CalculateLimit(1024, numItems, 8))
	}
	// Field 14: O
	{
		if len(c.O) != 4 {
			return ssz.ErrVectorLength
		}
		subIndx := hh.Index()
		for _, o := range c.O {
			if err := o.HashTreeRootWith(hh); err != nil {
				return fmt.Errorf("O: %w", err)
			}
		}
		hh.Merkleize(subIndx)
	}
	// Field 15: P
	{
		if len(c.P) != 4 {
			return ssz.ErrVectorLength
		}
		subIndx := hh.Index()
		for _, o := range c.P {

			{
				if len(o) > 64 {
					return ssz.ErrBytesLength
				}
				subIndx := hh.Index()
				hh.AppendBytes32(o)
				numItems := uint64(len(o))
				hh.MerkleizeWithMixin(subIndx, numItems, (64*1+31)/32)
			}

		}
		hh.Merkleize(subIndx)
	}
	// Field 16: Q
	{
		if len(c.Q) != 4 {
			return ssz.ErrVectorLength
		}
		subIndx := hh.Index()
		for _, o := range c.Q {
			if err := o.HashTreeRootWith(hh); err != nil {
				return fmt.Errorf("Q: %w", err)
			}
		}
		hh.Merkleize(subIndx)
	}
	// Field 17: R
	hh.PutBool(c.R)
	// Field 18: S
	hh.PutUint16(c.S)
	// Field 19: T
	hh.PutUint32(c.T)
	// Field 20: U
	{
		if len(c.U) > 32 {
			return ssz.ErrListTooBig
		}
		subIndx := hh.Index()
		for _, o := range c.U {
			{
				if len(o) > 16 {
					return ssz.ErrListTooBig
				}
				subIndx := hh.Index()
				for _, oo := range o {
					hh.AppendUint64(oo)
				}
				hh.FillUpTo32()
				numItems := uint64(len(o))
				hh.MerkleizeWithMixin(subIndx, numItems, ssz.CalculateLimit(16, numItems, 8))
			}
		}
		hh.MerkleizeWithMixin(subIndx, uint64(len(c.U)), 32)
	}
	// Field 21: V
	{
		if len(c.V) != 4 {
			return ssz.ErrVectorLength
		}
		subIndx := hh.Index()
		for _, o := range c.V {
			{
				if len(o) > 16 {
					return ssz.ErrListTooBig
				}
				subIndx := hh.Index()
				for _, oo := range o {
					hh.AppendUint64(oo)
				}
				hh.FillUpTo32()
				numItems := uint64(len(o))
				hh.MerkleizeWithMixin(subIndx, numItems, ssz.CalculateLimit(16, numItems, 8))
			}
		}
		hh.Merkleize(subIndx)
	}
	// Field 22: W
	if len([]byte(c.W)) != 32 {
		return ssz.ErrBytesLength
	}
	hh.PutBytes([]byte(c.W))
	// Field 23: X
	{
		if len(c.X) != 4 {
			return ssz.ErrVectorLength
		}
		subIndx := hh.Index()
		for _, o := range c.X {
			if len(o) != 1 {
				return ssz.ErrBytesLength
			}
			hh.PutBytes(o)
		}
		hh.Merkleize(subIndx)
	}
	// Field 24: Y
	{
		if len(c.Y) != 8 {
			return ssz.ErrVectorLength
		}
		subIndx := hh.Index()
		for _, o := range c.Y {
			hh.AppendUint32(o)
		}
		hh.Merkleize(subIndx)
	}
	// Field 25: Z
	{
		if len(c.Z) > 100 {
			return ssz.ErrListTooBig
		}
		subIndx := hh.Index()
		for _, o := range c.Z {
			hh.AppendUint16(o)
		}
		hh.FillUpTo32()
		numItems := uint64(len(c.Z))
		hh.MerkleizeWithMixin(subIndx, numItems, ssz.CalculateLimit(100, numItems, 2))
	}
	// Field 26: AA
	{
		if len(c.AA) != 2 {
			return ssz.ErrVectorLength
		}
		subIndx := hh.Index()
		for _, o := range c.AA {
			{
				if len(o) != 4 {
					return ssz.ErrVectorLength
				}
				subIndx := hh.Index()
				for _, oo := range o {
					hh.AppendUint64(oo)
				}
				hh.Merkleize(subIndx)
			}
		}
		hh.Merkleize(subIndx)
	}
	// Field 27: AB
	{
		if len(c.AB) > 32 {
			return ssz.ErrListTooBig
		}
		subIndx := hh.Index()
		for _, o := range c.AB {
			{
				if len(o) != 4 {
					return ssz.ErrVectorLength
				}
				subIndx := hh.Index()
				for _, oo := range o {
					hh.AppendUint64(oo)
				}
				hh.Merkleize(subIndx)
			}
		}
		hh.MerkleizeWithMixin(subIndx, uint64(len(c.AB)), 32)
	}
	// Field 28: AC
	if len(c.AC) != 32 {
		return ssz.ErrBytesLength
	}
	hh.PutBytes(c.AC[:])
	// Field 29: AD
	hh.PutUint8(c.AD)
	// Field 30: AE
	{
		if len(c.AE) != 4 {
			return ssz.ErrVectorLength
		}
		subIndx := hh.Index()
		for _, o := range c.AE {
			hh.AppendBool(o)
		}
		hh.Merkleize(subIndx)
	}
	// Field 31: AF
	{
		if len(c.AF) > 100 {
			return ssz.ErrListTooBig
		}
		subIndx := hh.Index()
		for _, o := range c.AF {
			hh.AppendBool(o)
		}
		hh.FillUpTo32()
		numItems := uint64(len(c.AF))
		hh.MerkleizeWithMixin(subIndx, numItems, ssz.CalculateLimit(100, numItems, 1))
	}
	// Field 32: AG
	{
		if len(c.AG) > 4 {
			return ssz.ErrListTooBig
		}
		subIndx := hh.Index()
		for _, o := range c.AG {
			if len(o) == 0 {
				return ssz.ErrEmptyBitlist
			}
			hh.PutBitlist(o, 2048)
		}
		hh.MerkleizeWithMixin(subIndx, uint64(len(c.AG)), 4)
	}
	// Field 33: AH
	{
		if len(c.AH) != 2 {
			return ssz.ErrVectorLength
		}
		subIndx := hh.Index()
		for _, o := range c.AH {
			if len(o) == 0 {
				return ssz.ErrEmptyBitlist
			}
			hh.PutBitlist(o, 2048)
		}
		hh.Merkleize(subIndx)
	}
	// Field 34: AI
	hh.AppendUint64(c.AI[0])
	hh.AppendUint64(c.AI[1])
	hh.AppendUint64(c.AI[2])
	hh.AppendUint64(c.AI[3])
	// Field 35: AJ
	{
		if len(c.AJ) > 8 {
			return ssz.ErrListTooBig
		}
		subIndx := hh.Index()
		for _, o := range c.AJ {
			hh.AppendUint64(o[0])
			hh.AppendUint64(o[1])
			hh.AppendUint64(o[2])
			hh.AppendUint64(o[3])
		}
		numItems := uint64(len(c.AJ))
		hh.MerkleizeWithMixin(subIndx, numItems, ssz.CalculateLimit(8, numItems, 32))
	}
	// Field 36: AK
	{
		if len(c.AK) != 2 {
			return ssz.ErrVectorLength
		}
		subIndx := hh.Index()
		for _, o := range c.AK {
			hh.AppendUint64(o[0])
			hh.AppendUint64(o[1])
			hh.AppendUint64(o[2])
			hh.AppendUint64(o[3])
		}
		hh.Merkleize(subIndx)
	}
	// Field 37: AL
	{
		if len(c.AL) > 16 {
			return ssz.ErrListTooBig
		}
		subIndx := hh.Index()
		for _, o := range c.AL {
			if len(o) != 48 {
				return ssz.ErrBytesLength
			}
			hh.PutBytes(o[:])
		}
		hh.MerkleizeWithMixin(subIndx, uint64(len(c.AL)), 16)
	}
	// Field 38: AM
	{
		if len(c.AM) != 4 {
			return ssz.ErrVectorLength
		}
		subIndx := hh.Index()
		for _, o := range c.AM {
			if len(o) != 32 {
				return ssz.ErrBytesLength
			}
			hh.Append(o[:])
		}
		hh.Merkleize(subIndx)
	}
	// Field 39: AN
	if len(c.AN) != 32 {
		return ssz.ErrBytesLength
	}
	hh.PutBytes(c.AN[:])
	// Field 40: AO
	{
		if len(c.AO) > 8 {
			return ssz.ErrListTooBig
		}
		subIndx := hh.Index()
		for _, o := range c.AO {
			if len(o) != 32 {
				return ssz.ErrBytesLength
			}
			hh.Append(o[:])
		}
		hh.MerkleizeWithMixin(subIndx, uint64(len(c.AO)), 8)
	}
	hh.Merkleize(indx)
	return nil
}
